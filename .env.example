# ============================================================================
# market-compass — .env.example
#
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# 把本文件复制为 .env 再填入真实值。
#
# NEVER commit the populated .env. It is .gitignore'd for a reason.
# 绝不提交填好的 .env 文件。.gitignore 中已显式排除。
# ============================================================================

# ---------------------------------------------------------------------------
# LLM providers / 大模型提供商
# ---------------------------------------------------------------------------
# Anthropic (Claude) — primary strong model / 主用强模型
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI — optional fallback / 可选兜底
OPENAI_API_KEY=your_openai_key_here

# Model routing / 模型路由
# Cheap model for daily extraction & classification.
# 便宜模型做日常抽取与分类。
LLM_CHEAP_MODEL=claude-haiku-4-5-20251001
# Strong model for weekly synthesis & triggered deep analysis.
# 强模型做周综合与事件触发分析。
LLM_STRONG_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Delivery — Telegram (primary) / 推送主通道 — Telegram
# ---------------------------------------------------------------------------
# Get these from @BotFather and @userinfobot on Telegram.
# 通过 @BotFather 创建 bot, 通过 @userinfobot 查询 chat_id。
TELEGRAM_BOT_TOKEN=0000000000:AAA_your_bot_token_here
TELEGRAM_CHAT_ID=0000000000

# ---------------------------------------------------------------------------
# Delivery — Email (redundant fallback) / 推送冗余兜底 — Email
# ---------------------------------------------------------------------------
# Use an SMTP app-password (Gmail: Google Account → Security → App passwords).
# 使用 SMTP 应用专用密码 (Gmail: 账户 → 安全 → 应用专用密码)。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password_here
EMAIL_FROM=your_email@example.com
EMAIL_TO=your_email@example.com

# ---------------------------------------------------------------------------
# News & data sources (all free tiers) / 新闻与数据源 (全部免费档)
# ---------------------------------------------------------------------------
# Finnhub — free tier: 60 req/min. https://finnhub.io
FINNHUB_API_KEY=your_finnhub_key_here

# FRED (St. Louis Fed) — free, requires API key.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# SEC EDGAR — no key, but requires a User-Agent identifying the project
# and a contact email.
# SEC EDGAR 不需要 key, 但要求 User-Agent 注明项目与联系邮箱。
SEC_EDGAR_USER_AGENT=market-compass/0.1 (contact: your_email@example.com)

# GDELT — no key required / 无需 API key
# (Included for documentation purposes.)

# ---------------------------------------------------------------------------
# Runtime toggles / 运行时开关
# ---------------------------------------------------------------------------
# Local timezone for the 7am push. Use IANA tz name.
# 本地时区,用于 7 点推送触发时间。IANA 时区名。
LOCAL_TZ=America/Toronto

# Dry-run mode: build the brief but skip actual delivery.
# Useful for testing prompts / classifiers without spamming yourself.
# Dry-run 模式: 生成简报但不推送,便于测试。
DRY_RUN=false

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
